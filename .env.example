# Public app settings
VITE_APP_NAME="Survivor Systems"

# Future Stripe Checkout integration
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_STRIPE_SUBSCRIPTION_URL=https://buy.stripe.com/...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# One-time bundle downloads use STRIPE_SECRET_KEY to verify Checkout Sessions.
# Canonical production origin used by the verified checkout return.
SITE_URL=https://survivorsystems.org

# Supabase public catalog connection. The browser-safe key is also the code fallback.
VITE_SUPABASE_URL=https://nwpqdpfhburdeprbfkqi.supabase.co
VITE_SUPABASE_ANON_KEY=your_browser_safe_anon_or_publishable_key
# Server-only URL used by the Stripe webhook.
SUPABASE_URL=https://nwpqdpfhburdeprbfkqi.supabase.co
# Server-only. Never prefix this with VITE_ or expose it to the browser.
# SUPABASE_SECRET_KEY=sb_secret_...
# Legacy fallback only:
# SUPABASE_SERVICE_ROLE_KEY=...
